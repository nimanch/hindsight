# =============================================================================
# Azure Foundry OpenAI Configuration for Hindsight + LongMemEval
# =============================================================================
#
# USAGE:
#   cp .env.azure.example .env
#   vi .env           # fill in your values
#   bash run_flask.sh # start the server (NOT "source .env" — see note below)
#
# IMPORTANT: This file is loaded by python-dotenv (not bash). Do NOT use:
#   - Shell variable expansion (e.g., $PATH, $HOME)
#   - The xport keyword
#   - Backtick or  command substitution
#   python-dotenv treats all values as literal strings.
#
# For PATH or shell-level config, use run_flask.sh instead.
# =============================================================================

# --- LLM Provider ---
HINDSIGHT_API_LLM_PROVIDER=azure
HINDSIGHT_API_LLM_MODEL=gpt-4o

# --- Azure Foundry Endpoint ---
# Your Azure AI Foundry / Azure OpenAI resource endpoint
HINDSIGHT_API_LLM_AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# API version (default: 2024-12-01-preview)
HINDSIGHT_API_LLM_AZURE_API_VERSION=2024-12-01-preview

# Deployment name (defaults to model name if not set)
# HINDSIGHT_API_LLM_AZURE_DEPLOYMENT_NAME=gpt-4o

# --- Authentication ---
# Option 1: Entra ID (recommended, default)
#   Requires: az login --tenant <your-tenant-id>
HINDSIGHT_API_LLM_AZURE_USE_ENTRA_ID=true

# Set your Azure tenant ID (required for cross-tenant auth in WSL)
# AZURE_TENANT_ID=<tenant-id-of-your-azure-resource>

# Option 2: API Key (set ENTRA_ID to false)
# HINDSIGHT_API_LLM_AZURE_USE_ENTRA_ID=false
# HINDSIGHT_API_LLM_API_KEY=your-azure-openai-api-key

# --- Token Limits ---
# Azure gpt-4o supports max 16384 completion tokens (not OpenAI's 64000)
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16000
# HINDSIGHT_API_LLM_AZURE_MAX_COMPLETION_TOKENS=16384

# --- Database ---
# pg0 = embedded PostgreSQL (zero setup, data stored in ~/.pg0/)
HINDSIGHT_API_DATABASE_URL=pg0

# --- Flask Bridge ---
FLASK_PORT=5001
# FLASK_DEBUG=true