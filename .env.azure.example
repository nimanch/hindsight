# =============================================================================
# Azure Foundry OpenAI Configuration for Hindsight + LongMemEval
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.azure.example .env
#   vi .env    # edit with your values
#   source .env
# =============================================================================

# --- LLM Provider ---
export HINDSIGHT_API_LLM_PROVIDER=azure
export HINDSIGHT_API_LLM_MODEL=gpt-4o

# --- Azure Foundry Endpoint ---
# Your Azure AI Foundry / Azure OpenAI resource endpoint
export HINDSIGHT_API_LLM_AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# API version (default: 2024-12-01-preview)
export HINDSIGHT_API_LLM_AZURE_API_VERSION=2024-12-01-preview

# Deployment name (defaults to model name if not set)
# export HINDSIGHT_API_LLM_AZURE_DEPLOYMENT_NAME=gpt-4o

# --- Authentication ---
# Option 1: Entra ID (recommended, default)
#   Requires: az login --tenant <tenant-id>
export HINDSIGHT_API_LLM_AZURE_USE_ENTRA_ID=true

# If your resource is in a different tenant than your default az login:
# export AZURE_TENANT_ID=<tenant-id-of-your-azure-resource>

# Option 2: API Key (set ENTRA_ID to false)
# export HINDSIGHT_API_LLM_AZURE_USE_ENTRA_ID=false
# export HINDSIGHT_API_LLM_API_KEY=your-azure-openai-api-key

# --- Token Limits ---
# Azure gpt-4o supports max 16384 completion tokens (not OpenAI's 64000)
export HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16000
# export HINDSIGHT_API_LLM_AZURE_MAX_COMPLETION_TOKENS=16384

# --- Database ---
# pg0 = embedded PostgreSQL (zero setup, data stored in ~/.pg0/)
export HINDSIGHT_API_DATABASE_URL=pg0

# --- Flask Bridge ---
export FLASK_PORT=5001
# export FLASK_DEBUG=true

# --- WSL PATH fix ---
# Ensure az CLI is findable by DefaultAzureCredential
export PATH="$PATH:/mnt/c/Program Files/Microsoft SDKs/Azure/CLI2/wbin"